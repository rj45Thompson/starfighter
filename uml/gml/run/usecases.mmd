flowchart LR
  %% actors
  A_pilot(["👤 Pilot"])
  A_rival(["👤 Another ship"])
  A_system(["👤 The game"])
  subgraph SYS["starblast — system boundary"]
    direction LR
    subgraph E1["E1 — Arrive and fly"]
      direction LR
      UC_E1_1["<b>UC-E1-1</b><br/>The page builds a world to fly in<br/><small>renderer</small>"]
      UC_E1_2["<b>UC-E1-2</b><br/>The game gives the pilot a ship<br/><small>makeShip</small>"]
      UC_E1_3["<b>UC-E1-3</b><br/>The simulation advances every frame<br/><small>frame</small>"]
      UC_E1_4["<b>UC-E1-4</b><br/>The pilot's controls move the ship<br/><small>THRUST</small>"]
      UC_E1_5["<b>UC-E1-5</b><br/>The pilot can see where the ship is going<br/><small>CAM_BACK</small>"]
    end
    subgraph E2["E2 — Mine the belt"]
      direction LR
      UC_E2_1["<b>UC-E2-1</b><br/>The system populates a belt with rocks<br/><small>makeMiningBelt</small>"]
      UC_E2_2["<b>UC-E2-2</b><br/>The system finds the rocks near the pilot cheaply<br/><small>AST_CELL</small>"]
      UC_E2_3["<b>UC-E2-3</b><br/>The pilot breaks a rock apart<br/><small>destroyAsteroid</small>"]
      UC_E2_4["<b>UC-E2-4</b><br/>Broken rock leaves gems in the world<br/><small>spawnGem</small>"]
      UC_E2_5["<b>UC-E2-5</b><br/>The pilot scoops a gem<br/><small>magnetFor</small>"]
      UC_E2_6["<b>UC-E2-6</b><br/>Collected credits bank an upgrade point<br/><small>gemBarAdd</small>"]
    end
    subgraph E3["E3 — Spend the point, or save for the hull"]
      direction LR
      UC_E3_1["<b>UC-E3-1</b><br/>The pilot spends a point on one of eight stats<br/><small>spendStat</small>"]
      UC_E3_2["<b>UC-E3-2</b><br/>Each point visibly changes how the ship performs<br/><small>statMult</small>"]
      UC_E3_3["<b>UC-E3-3</b><br/>Maxing every stat arms the trade-in<br/><small>tierUpReady</small>"]
      UC_E3_4["<b>UC-E3-4</b><br/>The game names the hull that comes next<br/><small>nextTierHull</small>"]
      UC_E3_5["<b>UC-E3-5</b><br/>Taking the new hull costs every upgrade bought<br/><small>takeTierUp</small>"]
      UC_E3_6["<b>UC-E3-6</b><br/>The traded-up frame outperforms the one it replaced<br/><small>HULLS</small>"]
    end
    subgraph E4["E4 — Fight, die, and lose the cargo"]
      direction LR
      UC_E4_1["<b>UC-E4-1</b><br/>Firing costs energy the pilot cannot spend forever<br/><small>capMaxFor</small>"]
      UC_E4_2["<b>UC-E4-2</b><br/>A shot travels a bounded distance<br/><small>BULLET_SPEED</small>"]
      UC_E4_3["<b>UC-E4-3</b><br/>A shot that connects damages what it hit<br/><small>BULLET_DMG</small>"]
      UC_E4_4["<b>UC-E4-4</b><br/>Shields take the hit before the hull does<br/><small>drainShield</small>"]
      UC_E4_5["<b>UC-E4-5</b><br/>A ship that runs out of hull dies<br/><small>killShip</small>"]
      UC_E4_6["<b>UC-E4-6</b><br/>Death spills the cargo for anyone to take<br/><small>spillGems</small>"]
      UC_E4_7["<b>UC-E4-7</b><br/>The pilot comes back small after a pause<br/><small>RESPAWN_DELAY</small>"]
    end
    subgraph E5["E5 — The run ends and is remembered"]
      direction LR
      UC_E5_1["<b>UC-E5-1</b><br/>The game gathers what is worth keeping<br/><small>gatherSaveState</small>"]
      UC_E5_2["<b>UC-E5-2</b><br/>The snapshot is written where it can be found again<br/><small>SAVE_KEY</small>"]
      UC_E5_3["<b>UC-E5-3</b><br/>The snapshot is kept current, not written only at the end<br/><small>SAVE_INTERVAL_S</small>"]
      UC_E5_4["<b>UC-E5-4</b><br/>A returning pilot gets their ship back<br/><small>applySaveState</small>"]
      UC_E5_5["<b>UC-E5-5</b><br/>The run's standing is a weighted total<br/><small>SCORE_W</small>"]
    end
  end
  S_belt_exists(("a belt of rocks exists"))
